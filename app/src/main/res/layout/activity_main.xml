<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">


    <!--Background Image -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <!-- Welcome Title centered near top -->
    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_message1"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.267" />

    <!-- Subtitle/Caption under the title -->
    <TextView
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_message2"
        android:textAlignment="center"
        android:textStyle="italic|bold"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.329" />

    <!-- "Username:" label -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:text="@string/usernameLabel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.304"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.401" />

    <!-- Username input field
     • Uses @drawable/bg_input for the rounded box
     • Left icon via drawableStart, tinted with @color/icon_tint -->
    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="315dp"
        android:layout_height="56dp"
        android:minHeight="48dp"
        android:autofillHints="username"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/outline_person_24"
        android:drawablePadding="8dp"
        android:drawableTint="@color/icon_tint"
        android:hint="@string/username"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.593"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.445" />

    <!-- "Password:" label -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="224dp"
        android:layout_height="wrap_content"
        android:text="@string/passwordLabel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.304"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:layout_constraintVertical_bias="0.172" />

    <!-- Password input field
     • Starts hidden (textPassword)
     • Left lock icon; right eye icon (static). The SHOW/HIDE toggle has to be handled in Java
       by swapping the transformation method and end icon on touch.
     • Extra end padding so text doesn’t sit under the eye icon. -->
    <EditText
        android:id="@+id/password"
        android:layout_width="315dp"
        android:layout_height="56dp"
        android:autofillHints="password"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/outline_lock_24"
        android:drawableEnd="@drawable/baseline_visibility_24"
        android:drawablePadding="8dp"
        android:drawableTint="@color/icon_tint"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.593"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.58"/>

    <!-- "Remember me" checkbox aligned under the password field -->
    <CheckBox
        android:id="@+id/rememberMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/icon_tint"
        android:text="@string/remember_me"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/password"
        app:layout_constraintTop_toBottomOf="@id/password"
        />

    <!-- Login button (green tint from @color/btn / white text @color/on_btn)-->
    <Button
        android:id="@+id/login_button"
        android:layout_width="147dp"
        android:layout_height="50dp"
        android:layout_marginBottom="116dp"
        android:backgroundTint="@color/btn"
        android:text="@string/log_in"
        android:textColor="@color/on_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.852"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password"
        app:layout_constraintVertical_bias="0.683" />

    <!-- Cancel button (styled same as login)-->
    <Button
        android:id="@+id/cancel_button"
        android:layout_width="147dp"
        android:layout_height="50dp"
        android:layout_marginBottom="116dp"
        android:backgroundTint="@color/btn"
        android:text="@string/cancel_text"
        android:textColor="@color/on_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.215"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password"
        app:layout_constraintVertical_bias="0.683" />

    <!--Link to registration screen -->
    <TextView
        android:id="@+id/linkRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:minHeight="48dp"
        android:text="@string/register_message"
        android:textColor="@color/btn"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_button" />


    <!-- Message area for validation/auth feedback (set text/color from Java)-->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="315dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text=""
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/password"
        app:layout_constraintTop_toBottomOf="@id/rememberMe" />

</androidx.constraintlayout.widget.ConstraintLayout>

